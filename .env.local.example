# ============================================
#  NeonDB (PostgreSQL) — required
# ============================================
# Sign up free at https://neon.tech
# Create a project, then copy the "Pooled connection" string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ============================================
#  Cloudinary — required for image/video uploads
# ============================================
# Sign up free at https://cloudinary.com
# Dashboard -> Product Environment Credentials -> copy values below.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# (Public, used by client uploader)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ============================================
#  Admin login (one account, server-side)
# ============================================
ADMIN_EMAIL="studio@architectsilas.com"
# Plain password used at first boot to seed the admin row; ignored after.
ADMIN_PASSWORD="ChangeMe@2026"

# ============================================
#  Session signing
# ============================================
# Generate with:  openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
